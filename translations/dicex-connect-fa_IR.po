msgstr "مهلت این کد تمام شد. کد تازه بخواهید."

msgid "Confirm sign-in"
msgstr "تأیید ورود"

msgid "Back to the login page"
msgstr "بازگشت به صفحهٔ ورود"

msgid "You are being called with the code. Answer the call and enter what you hear."
msgstr "کد با تماس تلفنی به شما گفته می‌شود. تماس را پاسخ دهید و آنچه می‌شنوید را وارد کنید."

msgid "Enter the code sent to you by %s."
msgstr "کدی را که از طریق %s برایتان ارسال شد وارد کنید."

msgid "Enter the code that was sent to you."
msgstr "کدی را که برایتان ارسال شد وارد کنید."

msgid "Login code"
msgstr "کد ورود"

msgid "Confirm and sign in"
msgstr "تأیید و ورود"

msgid "Sign in with mobile"
msgstr "ورود با موبایل"

msgid "Send code"
msgstr "ارسال کد"

